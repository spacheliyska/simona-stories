# Dependencies (reinstalled with `npm install`)
node_modules/

# Build output (recreated with `npm run build`, and by GitHub Actions)
dist/
dist-ssr/

# Local environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editors & OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Full-size originals (web copies live in public/photos)
originals/

# My photos live in their own private repo (cloned into public/photos), never in this public one
public/photos/
